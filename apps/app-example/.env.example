# Variabili d'ambiente per Next-Auth e SPID/CIE OIDC

# Segreto per Next-Auth (obbligatorio per produzione)
NEXTAUTH_SECRET=

# URL base per Next-Auth
NEXTAUTH_URL=http://localhost:3000

# Configurazione OIDC per SPID/CIE
SPID_CIE_OIDC_ISSUER=
SPID_CIE_OIDC_CLIENT_ID=
SPID_CIE_OIDC_CLIENT_SECRET=

# Opzionale: ACR Values per SPID/CIE (livelli di autenticazione)
# Default: "https://www.spid.gov.it/SpidL2 https://www.cartaidentita.it/cie-l2"
SPID_CIE_OIDC_ACR_VALUES=

# Opzionale: Endpoint espliciti (se non derivabili dall'issuer)
# SPID_CIE_OIDC_TOKEN_ENDPOINT=
# SPID_CIE_OIDC_USERINFO_ENDPOINT=