# Next.js build output and cache
.next/

# Turborepo cache
.turbo/

# TypeScript cache
*.tsbuildinfo

# Jest coverage output
coverage/

# Playwright output
test-results/
playwright-report/
playwright/.auth/ # Cartella per storageState salvato

# VS Code specific files to ignore
# Ignora tutto dentro .vscode tranne i file che vogliamo condividere
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json # Opzionale: committa se vuoi condividere config di debug

# Local environment variables
# NON committare mai i tuoi segreti locali!
.env.local
.env.*.local

# MA non ignorare i file .env.example
!.env.example
!**/.env.example

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories and files
.idea
*.iml
*.swp
*~

# Miscellaneous
*.sublime-project
*.sublime-workspace

